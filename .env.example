# Shared by both example gateways. Never commit real secrets.
OPENAI_API_KEY=replace-from-secret-manager

# Multi-provider support. Set the default provider and any provider API keys you
# want to enable; a provider is available once its key is present. Every non-OpenAI
# provider is billed through the OpenAI-compatible Chat Completions API.
PROVIDER=openai
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# PERPLEXITY_API_KEY=
# CEREBRAS_API_KEY=
# Add custom OpenAI-compatible providers (id, base_url, api: responses|chat, api_key):
# PROVIDERS_JSON=[{"id":"my-llm","base_url":"https://llm.internal/v1","api":"chat","api_key":"..."}]

FACILITATOR_URL=https://x402.org/facilitator
NETWORK=eip155:84532
PAY_TO_ADDRESS=0x1111111111111111111111111111111111111111
REDIS_URL=redis://localhost:6379
IDEMPOTENCY_HMAC_SECRET=replace-with-at-least-32-random-characters
MAX_PAYMENT_USD=$1.00
MAX_OUTPUT_TOKENS=16000
IDEMPOTENCY_TTL_SECONDS=86400
NODE_ENV=development
PORT=4021

# Replace model names and rates with a reviewed, versioned price table.
PRICING_JSON={"version":"replace-before-deploying","models":{"your-enabled-model":{"inputUsdPerMillion":"1.00","cachedInputUsdPerMillion":"0.10","outputUsdPerMillion":"5.00","providerMarkupBps":1000,"fixedFeeUsd":"0.001"}}}

# TypeScript-only optional settings.
LOG_LEVEL=info
TRUST_PROXY=false
CORS_ORIGINS=
OPENAI_TIMEOUT_MS=120000
BODY_LIMIT=256kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Python uses seconds for its upstream timeout.
OPENAI_TIMEOUT_SECONDS=120
